{
  "manifest_version": 3,
  "name": "PromptGuard",
  "version": "1.0.0",
  "description": "Blocks API keys, passwords, government IDs, card numbers and other high-risk data before a prompt is sent to an AI chat tool.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://gemini.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://gemini.google.com/*"],
      "js": ["backstop.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
