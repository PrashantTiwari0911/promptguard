{
  "name": "promptguard",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that blocks high-risk data in prompts to claude.ai, chatgpt.com and gemini.google.com before they are sent.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bench.mjs --log-level=warning && node node_modules/.cache/bench.mjs",
    "e2e": "node build.mjs && playwright test",
    "zip": "node build.mjs && cd dist && zip -qr ../promptguard.zip .",
    "synthetic": "esbuild scripts/gen-synthetic.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen.mjs --log-level=warning && node node_modules/.cache/gen.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
